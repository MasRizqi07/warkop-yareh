# ============================================
# WARKOP YA'REH DIGITAL PLATFORM — ENV TEMPLATE
# ============================================
# Copy this file to:
#   apps/api/.env
#   packages/database/.env
#   apps/web/.env.local
#   apps/admin/.env.local
# Fill in all required values before starting.
# NEVER commit actual .env files to git.

# ── DATABASE ──────────────────────────────────
DATABASE_URL=postgresql://warkopyareh:warkopyareh_pass@localhost:5432/warkopyareh_db

# ── REDIS ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-random-256bit-secret-minimum-32-chars
JWT_REFRESH_SECRET=change-this-to-another-different-256bit-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── GOOGLE OAUTH ──────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Leave blank to disable Google OAuth (will return 503 if called)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── MIDTRANS SANDBOX ──────────────────────────
# Get from: https://dashboard.sandbox.midtrans.com
# Leave blank to disable payment gateway (will return 503 if called)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ── EMAIL / OTP DELIVERY ──────────────────────
# Required in production because OTP login must never silently drop messages.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@warkopyareh.com

# ── WHATSAPP CLOUD API ────────────────────────
# Required in production for the admin marketing campaign module.
# The approved template must contain three body parameters in this order:
# campaign name, discount percentage, and expiry hours.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_CAMPAIGN_TEMPLATE_NAME=yareh_campaign_v1
WHATSAPP_LANGUAGE_CODE=id
# Required only when a campaign enables header media.
WHATSAPP_HEADER_IMAGE_URL=
# Safety cap for one background dispatch job (1-1000).
WHATSAPP_BROADCAST_MAX_RECIPIENTS=100

# ── APP CONFIG ────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
BACKEND_URL=http://localhost:4000
# Set to the shared parent domain in production (for example: .warkopyareh.com)
# so the frontend proxies can see the HttpOnly refresh cookie. Leave blank locally.
COOKIE_DOMAIN=

# ── FRONTEND (NEXT_PUBLIC_ = exposed to browser) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# ── BCRYPT ────────────────────────────────────
BCRYPT_ROUNDS=12

# Required when running the seed command with NODE_ENV=production.
SEED_ADMIN_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_KITCHEN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ── RATE LIMITING ─────────────────────────────
THROTTLE_TTL=900000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5
