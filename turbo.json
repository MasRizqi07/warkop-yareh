{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@warkop-yareh/ui#build": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@warkop-yareh/api#test": {
      "dependsOn": ["^build", "test:persistence"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "MIDTRANS_SERVER_KEY",
        "NODE_ENV"
      ]
    },
    "test:persistence": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "MIDTRANS_SERVER_KEY",
        "NODE_ENV"
      ]
    }
  }
}
